# ---------------------------------------------------------------- Voice calls
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
# Public origin Vapi posts decisions and end-of-call reports back to. Required:
# without it a worker who never answers strands the rescue on CALLING_WORKER.
# Register it with Vapi from /admin -> "Register webhook with Vapi" after deploy.
PUBLIC_BASE_URL=
# Optional explicit override; defaults to PUBLIC_BASE_URL.
VAPI_TOOL_SERVER_URL=
# Optional. Default: gpt-4o / alloy.
VAPI_OPENAI_MODEL=
VAPI_OPENAI_VOICE=

# ------------------------------------------------------------ SMS and numbers
# Any one of these three is used as the a1mobile X-Team-Key.
A1MOBILE_API_KEY=
A1MOBILE_TEAM_KEY=
A1MOBILE_PHONE_NUMBER=
# Only needed once, to build the Vapi SIP trunk (spike-sip-trunk.mjs).
A1MOBILE_SIP_USERNAME=
A1MOBILE_SIP_PASSWORD=

# ------------------------------------------------------------------- Workflow
# outbound = Vapi dials the worker | inbound = SMS invites a callback
ORIGINATION=outbound
# true = no real calls or texts are sent. Simulated runs produce sim- ids, which
# the API contract states are NOT sponsor proof — keep this false for a demo.
SIMULATE=false

# Roster seed. A worker with no number is silently dropped from the call queue.
DEMO_WORKER_1_PHONE=
DEMO_WORKER_2_PHONE=
DEMO_WORKER_3_PHONE=

# --------------------------------------------------------------------- Venue
VENUE_NAME=
VENUE_LOCATION=
# IANA zone the shifts are scheduled in. Default: America/Los_Angeles.
SHIFT_TIME_ZONE=

# ---------------------------------------------------------------------- Auth
# One shared operator password. REQUIRED in production: without it nobody can
# sign in, so no rescue can be started and the staff directory stays sealed.
APP_PASSWORD=
# Optional. Signs session cookies; falls back to APP_PASSWORD.
APP_SESSION_SECRET=

# -------------------------------------------------------------------- State
# REQUIRED on Vercel — several function instances serve requests, so the
# webhook and the browser cannot share an in-process object. Without these the
# app throws on every request. Locally, omit them to use in-process state.
# (vercel integration add upstash/upstash-kv supplies the KV_ names.)
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ------------------------------------------------------------------- VoiceOS
# Read by the Python MCP bridge in src/integrations/voiceos/, not by the app.
SHIFTRESCUE_BASE_URL=
SHIFTRESCUE_SPREADSHEET_ID=

# ------------------------------------------------------- Not read by this app
# Kept because the sponsor docs issue them. The voice model is configured on the
# Vapi side, and the MCP bridge is launched locally over stdio rather than
# authenticated, so nothing in src/ reads any of these.
# a1mobile AI gateway — see docs/A1MOBILE-TELEPHONY.md.
OPENAI_API_KEY=
OPENAI_BASE_URL=
VOICEOS_API_KEY=
