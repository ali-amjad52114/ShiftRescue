# No trailing slash: a worktree setup once committed node_modules as a symlink,
# which "node_modules/" does not match, and merging it replaced everyone's
# installed dependencies with a 21-byte file.
node_modules
.next/
.env
.env.local
npm-debug.log*
*.tsbuildinfo
.vercel
.env*.local
.aidesigner/*
!.aidesigner/.gitkeep
.env*

Call_list - Sheet1.csv
campaign-template.csv

# Local working notes. These contain demo phone numbers and live resource ids,
# so keep the rule here rather than in .git/info/exclude, which is never cloned.
ARCHITECTURE.md
SWAYAM-WORK.md
testing_plan.md

# Call logs carry full transcripts of real calls with real workers.
logs/
.playwright-mcp/
.claude/
